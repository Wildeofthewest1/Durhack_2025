; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="400 (Durhack)"
run/main_scene="uid://dwju5ceubg651"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

FleetManager="*res://Scenes/Managers/FleetManager.gd"
PlayerVariables="*res://Scenes/Player/PlayerVariables.gd"
Screenshake="*res://Scenes/Camera/Screenshake.gd"
WaveManager="*res://Scenes/Waves/WaveManager.gd"
ResourceManager="*res://Data/Game Resources/ResourceManager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PauseManager="*res://Scenes/Game/PauseManager.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}
layout/style_directory={
"": "res://Scenes/Dialogue/Dialogue_Style_test.tres",
"Dialogue_Style_test": "res://Scenes/Dialogue/Dialogue_Style_test.tres"
}
layout/style_list=["res://Scenes/Dialogue/Dialogue_Style_test.tres"]
